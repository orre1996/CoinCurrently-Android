<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top|start"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/txt_portfolio_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Portfolio Value"
        android:textColor="#929090"
        android:textFontWeight="700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_total_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="$84,528.15"
        android:textColor="#FFFFFF"
        android:textFontWeight="700"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_pl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="24h Change"
        android:textColor="#929090"
        android:textFontWeight="700"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="top|start"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/view_price_change"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/trend_up"
            android:tint="#42E099" />

        <TextView
            android:id="@+id/txt_pl_change"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="start"
            android:includeFontPadding="false"
            android:maxLines="3"
            android:text="$576.92 (+0.62%)"
            android:textColor="#FF42E099"
            android:textFontWeight="700"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
