<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_duo_widget"
        android:layout_width="330dp"
        android:layout_height="165dp"
        android:background="@drawable/widget_background_dark"
        android:orientation="horizontal"
        android:weightSum="2"
        android:baselineAligned="false">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="16dp"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center|start"
                    android:ellipsize="end"
                    android:text="Coin\nCurrently"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:layout_weight="1"/>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:gravity="center|end"
                    android:src="@drawable/logo_dark"
                    android:layout_marginStart="10dp"
                    android:scaleType="fitCenter"
                    app:layout_constraintDimensionRatio="H,1:1"
                    android:adjustViewBounds="true"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:textSize="22sp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:gravity="start|center"
                android:maxLines="1"
                android:text="$0.00"
                android:layout_weight="1"
                android:layout_marginBottom="5dp"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="start|center"
                        android:maxLines="1"
                        android:text="24h:"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="4sp"
                        android:autoSizeTextType="uniform"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="start|center"
                        android:maxLines="1"
                        android:text="7d:"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="4sp"
                        android:autoSizeTextType="uniform"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="start|center"
                        android:maxLines="1"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="4sp"
                        android:autoSizeTextType="uniform"
                        android:text="30d:"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginHorizontal="10dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:text="0.00%"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="4sp"
                        android:autoSizeTextType="uniform"
                        android:textColor="#C9C6C5"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginHorizontal="10dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:text="0.00%"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="4sp"
                        android:autoSizeTextType="uniform"
                        android:textColor="#C9C6C5"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="17dp"
                        android:layout_marginHorizontal="10dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="4sp"
                        android:autoSizeTextType="uniform"
                        android:textColor="#C9C6C5"
                        android:textSize="12sp"
                        android:text="0.00%" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:layout_marginTop="6dp"
                        android:src="@drawable/trend_still"
                        app:tint="#C9C6C5" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:layout_marginVertical="11dp"
                        android:src="@drawable/trend_still"
                        app:tint="#C9C6C5" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/trend_still"
                        app:tint="#C9C6C5" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:weightSum="1"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="2"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>

                        <ImageButton
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:background="@null"
                            android:paddingTop="16dp"
                            android:foregroundGravity="bottom"
                            android:visibility="invisible"
                            android:src="@drawable/refresh_icon"
                            android:layout_weight="1"
                            android:scaleType="fitEnd">
                        </ImageButton>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        </RelativeLayout>

        <include
            layout="@layout/widget_separator_vertical_dark"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_margin="16dp"
                android:weightSum="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|start"
                        android:ellipsize="end"
                        android:text="Coin\nCurrently"
                        android:maxLines="2"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:layout_weight="1"/>

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:gravity="center|end"
                        android:src="@drawable/logo_dark"
                        android:layout_marginStart="10dp"
                        android:scaleType="fitCenter"
                        app:layout_constraintDimensionRatio="H,1:1"
                        android:adjustViewBounds="true"/>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:textSize="22sp"
                    android:autoSizeMaxTextSize="22sp"
                    android:autoSizeMinTextSize="12sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="start|center"
                    android:maxLines="1"
                    android:text="$0.00"
                    android:layout_weight="1"
                    android:layout_marginBottom="5dp"
                    android:textColor="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:gravity="start|center"
                            android:maxLines="1"
                            android:text="24h:"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="4sp"
                            android:autoSizeTextType="uniform"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:gravity="start|center"
                            android:maxLines="1"
                            android:text="7d:"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="4sp"
                            android:autoSizeTextType="uniform"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:gravity="start|center"
                            android:maxLines="1"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="4sp"
                            android:autoSizeTextType="uniform"
                            android:text="30d:"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:layout_marginHorizontal="10dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:gravity="center"
                            android:text="0.00%"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="4sp"
                            android:autoSizeTextType="uniform"
                            android:textColor="#C9C6C5"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:layout_marginHorizontal="10dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:gravity="center"
                            android:text="0.00%"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="4sp"
                            android:autoSizeTextType="uniform"
                            android:textColor="#C9C6C5"
                            android:textSize="12sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="17dp"
                            android:layout_marginHorizontal="10dp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:gravity="center"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="4sp"
                            android:autoSizeTextType="uniform"
                            android:textColor="#C9C6C5"
                            android:textSize="12sp"
                            android:text="0.00%" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="6dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/trend_still"
                            android:layout_marginTop="6dp"
                            app:tint="#C9C6C5" />


                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="6dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/trend_still"
                            android:layout_marginVertical="11dp"
                            app:tint="#C9C6C5" />


                        <ImageView
                            android:layout_width="10dp"
                            android:layout_height="6dp"
                            android:layout_gravity="center"
                            android:scaleType="centerCrop"
                            android:src="@drawable/trend_still"
                            app:tint="#C9C6C5" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:weightSum="1"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:weightSum="2"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"/>

                            <ImageButton
                                android:layout_width="35dp"
                                android:layout_height="35dp"
                                android:background="@null"
                                android:paddingTop="16dp"
                                android:foregroundGravity="bottom"
                                android:visibility="invisible"
                                android:src="@drawable/refresh_icon"
                                android:layout_weight="1"
                                android:scaleType="fitEnd">
                            </ImageButton>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageButton
                    android:id="@+id/btn_reload"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/widget_reload_button_bg_bottom_dark"
                    android:foregroundGravity="bottom"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_baseline_sync_24_dark" />

            </RelativeLayout>

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>