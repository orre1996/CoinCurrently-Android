<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/widget_background_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:weightSum="2">

        <RelativeLayout
            android:layout_width="175dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            app:layout_constraintDimensionRatio="H,1:1">

            <ImageView
                android:id="@+id/img_pie"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:src="@drawable/portfolio_empty_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignStart="@id/img_pie"
                android:layout_alignTop="@id/img_pie"
                android:layout_alignEnd="@id/img_pie"
                android:layout_alignBottom="@id/img_pie"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="30dp"
                android:paddingTop="10dp"
                app:layout_constraintDimensionRatio="H,1:1">

                <TextView
                    android:id="@+id/txt_total_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="$0.00"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/txt_timeframe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:text="P/L:"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/txt_change"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:text="0.00%"
                        android:textColor="#C9C6C5"
                        android:textSize="12sp"/>

                    <ImageView
                        android:id="@+id/view_price_change"
                        android:layout_width="10dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/trend_still"
                        app:tint="#C9C6C5"
                        android:visibility="gone"/>

                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginVertical="5dp"
                android:weightSum="5">

                <TextView
                    android:id="@+id/txt_symbol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="start"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:text="SYMBOL"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_balance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="start"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:text="BALANCE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="start"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:text="VALUE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_PLN"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="start"
                    android:maxLines="1"
                    android:paddingStart="5dp"
                    android:text="P/L"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txt_ratio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="start"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:text="RATIO %"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_coins"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:weightSum="4">

                <ImageView
                    android:id="@+id/first_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3FC9C6C5" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/second_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:background="#3FC9C6C5" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/third_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:background="#3FC9C6C5" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/fourth_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="5dp"
                    android:background="#3FC9C6C5" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btn_open"
        android:layout_width="350dp"
        android:layout_height="350dp">

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/widget_reload_button_bg_dark"
            android:foregroundGravity="bottom"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_sync_24_dark"
            android:visibility="visible" />

    </RelativeLayout>

    <include
        android:id="@+id/buy_pro"
        layout="@layout/buy_pro_overlay"
        android:layout_height="350dp"
        android:layout_width="350dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <include
        android:id="@+id/buy_pro_light"
        layout="@layout/buy_pro_overlay_light"
        android:layout_height="330dp"
        android:layout_width="330dp"
        android:visibility="gone"
        tools:visibility="visible"/>

</RelativeLayout>