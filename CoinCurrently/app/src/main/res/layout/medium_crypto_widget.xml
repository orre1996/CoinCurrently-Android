<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_view"
        android:layout_width="350dp"
        android:layout_height="165dp"
        android:background="@drawable/widget_background_dark"
        android:paddingBottom="5dp"
        android:paddingTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:weightSum="2">

            <ImageView
                android:id="@+id/img_currency"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/logo_dark"/>

            <TextView
                android:id="@+id/txt_currency_rank"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:gravity="start|center"
                android:maxLines="1"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:text="CoinCurrently" />

            <TextView
                android:id="@id/txt_currency_price"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:autoSizeMaxTextSize="24sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:layout_weight="1"
                android:text="$0.00" />

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingVertical="3dp"
                android:visibility="invisible"
                android:paddingStart="10dp"
                android:src="@drawable/refresh_icon"
                android:scaleType="fitEnd">
            </ImageButton>

        </LinearLayout>

        <ImageView
            android:id="@+id/currency_graph"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:weightSum="3"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_24h_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:text="24h:"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_24h_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeTextType="uniform"
                    android:textColor="#C9C6C5"
                    android:textSize="12sp"
                    android:text="0.00%" />

                <ImageView
                    android:id="@+id/img_24h_change_symbol"
                    android:layout_width="10dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trend_still"
                    app:tint="#C9C6C5" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_7d_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="7d:"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeTextType="uniform"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_7d_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeTextType="uniform"
                    android:textColor="#C9C6C5"
                    android:textSize="12sp"
                    android:text="0.00%" />

                <ImageView
                    android:id="@+id/img_7d_change_symbol"
                    android:layout_width="10dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trend_still"
                    app:tint="#C9C6C5" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_30d_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:maxLines="1"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeTextType="uniform"
                    android:text="30d:"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_30d_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:gravity="center"
                    android:autoSizeMaxTextSize="12sp"
                    android:autoSizeMinTextSize="4sp"
                    android:autoSizeTextType="uniform"
                    android:textColor="#C9C6C5"
                    android:textSize="12sp"
                    android:text="0.00%" />

                <ImageView
                    android:id="@+id/img_30d_change_symbol"
                    android:layout_width="10dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trend_still"
                    app:tint="#C9C6C5" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btn_open"
        android:layout_width="350dp"
        android:layout_height="165dp">

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_reload_button_bg_dark"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_sync_24_dark" />

    </RelativeLayout>

</RelativeLayout>