<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:layout_weight="1">

    <LinearLayout
        android:id="@+id/ll_view"
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:orientation="vertical"
        android:background="@drawable/widget_background_dark"
        android:weightSum="1">
    </LinearLayout>

    <TextView
        android:id="@+id/txt_questionmark"
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:fontFamily="@font/poppins_semibold"
        android:includeFontPadding="false"
        android:gravity="center"
        android:text="\?"
        android:textColor="#B3C9C6C5"
        android:textSize="22sp" />

    <ImageView
        android:id="@+id/img_small_news_image"
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:scaleType="centerCrop"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:layout_width="165dp"
            android:layout_height="130dp"
            android:background="@drawable/large_news_card_fade_widget"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="165dp"
        android:layout_height="165dp"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/sentiment_badge_background"
            android:padding="4dp">
            <ImageView
                android:id="@+id/img_sentiment"
                android:layout_width="10dp"
                android:layout_height="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/trend_still"
                app:tint="#C9C6C5"/>
        </FrameLayout>

        <TextView
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:gravity="start"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:text="Crypto News"/>

        <TextView
            android:id="@+id/txt_published"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:fontFamily="@font/poppins_light"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:text="CoinCurrently"/>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btn_open"
        android:layout_width="165dp"
        android:layout_height="165dp">
    </RelativeLayout>

</RelativeLayout>