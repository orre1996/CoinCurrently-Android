<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_dark"
        android:gravity="top|start"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_index"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="top|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="50"
            android:textColor="#FFFFFF"
            android:textFontWeight="700"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_classification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Neutral"
            android:textColor="#FFDF2E"
            android:textFontWeight="700"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Fear" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/meter_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/meter_extreme_fear"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/small_fear_greed_red_bg" />

                <TextView
                    android:id="@+id/meter_fear"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:background="#FB9145" />

                <TextView
                    android:id="@+id/meter_neutral"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:background="#FFDF2E" />

                <TextView
                    android:id="@+id/meter_greed"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:background="#A8DF5F" />

                <ImageView
                    android:id="@+id/meter_extreme_greed"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/small_fear_greed_green_bg" />

            </LinearLayout>

            <ImageView
                android:id="@+id/img_indicator_preview"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="@null"
                android:src="@drawable/fear_greed_circular_indicator_dark"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/img_indicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center_vertical|start"
                android:contentDescription="@null"
                android:scaleType="fitXY" />

        </FrameLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btn_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
