<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/ll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_background_dark"
        android:weightSum="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="16dp"
            android:weightSum="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/img_currency"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center|end"
                    android:src="@drawable/bitcoin"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintDimensionRatio="H,1:1"
                    android:adjustViewBounds="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_currency_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textFontWeight="700"
                    android:includeFontPadding="false"
                    android:gravity="center|start"
                    android:ellipsize="end"
                    android:text="Bitcoin"
                    android:maxLines="2"
                    android:textColor="#FCF8F8"
                    android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/txt_currency_symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textFontWeight="700"
                        android:includeFontPadding="false"
                        android:gravity="center|start"
                        android:ellipsize="end"
                        android:text="BTC"
                        android:maxLines="2"
                        android:textColor="#C9C6C5"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/txt_currency_price"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textFontWeight="700"
                android:includeFontPadding="false"
                android:gravity="start|center"
                android:maxLines="1"
                android:text="$63,695.00"
                android:layout_weight="1"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center"
                android:orientation="horizontal"
                android:baselineAligned="false">

                    <TextView
                        android:id="@+id/txt_24h_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textFontWeight="700"
                        android:includeFontPadding="false"
                        android:gravity="start|center"
                        android:maxLines="1"
                        android:text="24h"
                        android:layout_marginEnd="4dp"
                        android:textColor="#929090"
                        android:textSize="12sp" />

                <ImageView
                    android:id="@+id/img_24h_change_symbol"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:src="@drawable/trend_up"
                    android:tint="#42E099"
                    android:tintMode="src_in" />

                    <TextView
                        android:id="@+id/txt_24h_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textFontWeight="700"
                        android:includeFontPadding="false"
                        android:text="2.36%"
                        android:autoSizeTextType="uniform"
                        android:textColor="#42E099"
                        android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btn_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
