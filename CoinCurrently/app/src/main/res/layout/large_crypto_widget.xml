<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/widget_background_dark"
        android:paddingBottom="5dp"
        android:paddingTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <ImageView
                android:id="@+id/img_currency"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="5dp"
                android:src="@drawable/logo_dark"/>

            <TextView
                android:id="@+id/txt_currency_rank"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="12dp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:gravity="start|center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:text="CoinCurrently" />

            <TextView
                android:id="@id/txt_currency_price"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:gravity="center|end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:text="$0.00" />

            <ImageButton
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingVertical="3dp"
                android:visibility="visible"
                android:paddingStart="10dp"
                android:src="@drawable/refresh_icon"
                android:scaleType="fitEnd">
            </ImageButton>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="45dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/txt_timeframe_start"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:text="1 Jan"  />

            <TextView
                android:id="@+id/txt_timeframe_middle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:textSize="14sp"
                android:text="2 Jan"  />

            <TextView
                android:id="@+id/txt_timeframe_end"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:text="3 Jan"  />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginVertical="5dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="4"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/chart_vertical_start"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#3FC9C6C5"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/chart_vertical_middle"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#3FC9C6C5"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/chart_vertical_end"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#3FC9C6C5"/>

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="4"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/chart_horizontal_top"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3FC9C6C5"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/chart_horizontal_middle"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3FC9C6C5"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/chart_horizontal_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#3FC9C6C5"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/currency_graph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible"
                android:weightSum="4">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_price_high"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center|start"
                    android:maxLines="1"
                    android:padding="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:background="@drawable/widget_number_background_dark"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="5dp"
                    android:textSize="14sp"
                    android:text="$0.00" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_price_middle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center|start"
                    android:maxLines="1"
                    android:padding="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:background="@drawable/widget_number_background_dark"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:text="$0.00"  />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_price_low"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center|start"
                    android:background="@drawable/widget_number_background_dark"
                    android:maxLines="1"
                    android:padding="3dp"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/poppins_regular"
                    android:includeFontPadding="false"
                    android:textSize="14sp"
                    android:text="$0.00"
                    android:layout_marginBottom="20dp"/>

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

            </LinearLayout>

        </RelativeLayout>


        <LinearLayout
            android:id="@+id/ll_volume_chart"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            tools:background="#42E099"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_open_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="Open"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_open_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:text="$0.00"  />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_high_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="High"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_high_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:text="$0.00"  />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_low_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="Low"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_low_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:text="$0.00"  />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/view_separator"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:alpha="0.25"
                android:background="#C9C6C5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_volume_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="Volume"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_volume_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:gravity="center|end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:text="$0.00"  />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_mkt_cap_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="Mkt Cap"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_mkt_cap_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:ellipsize="end"
                        android:gravity="center|end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:text="$0.00"  />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/txt_change_title"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center|start"
                        android:maxLines="1"
                        android:text="Change"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txt_change_value"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="8sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center|end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:text="$0.00"  />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/btn_open"
        android:layout_width="350dp"
        android:layout_height="350dp">

        <ImageButton
            android:id="@+id/btn_reload"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/widget_reload_button_bg_dark"
            android:src="@drawable/ic_baseline_sync_24_dark"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerInside"
            android:layout_alignParentEnd="true">
        </ImageButton>

    </RelativeLayout>

    <include
        android:id="@+id/buy_pro"
        layout="@layout/buy_pro_overlay"
        android:layout_height="350dp"
        android:layout_width="350dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <include
        android:id="@+id/buy_pro_light"
        layout="@layout/buy_pro_overlay_light"
        android:layout_height="350dp"
        android:layout_width="350dp"
        android:visibility="gone"
        tools:visibility="visible"/>

</RelativeLayout>