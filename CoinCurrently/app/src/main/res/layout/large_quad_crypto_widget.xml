<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_quad_widget"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background_dark"
        android:orientation="vertical"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/cell_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:layout="@layout/small_crypto_widget_cell" />

            <include
                android:id="@+id/separator_vertical_1"
                layout="@layout/widget_separator_vertical_dark"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="16dp" />

            <LinearLayout
                android:id="@+id/cell_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:layout="@layout/small_crypto_widget_cell_ethereum" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/first_separator"
                layout="@layout/widget_separator_dark"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/second_separator"
                layout="@layout/widget_separator_dark"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/cell_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:layout="@layout/small_crypto_widget_cell_usdt" />

            <include
                android:id="@+id/separator_vertical_2"
                layout="@layout/widget_separator_vertical_dark"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="16dp" />

            <LinearLayout
                android:id="@+id/cell_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                tools:layout="@layout/small_crypto_widget_cell_bnb" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
