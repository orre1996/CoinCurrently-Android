<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/ll_main"
        android:layout_width="330dp"
        android:layout_height="330dp"
        android:background="@drawable/widget_background_dark"
        android:orientation="vertical"
        android:gravity="center"
        android:weightSum="4">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:layout_weight="2"
            android:clipChildren="true">

            <TextView
                android:id="@+id/txt_questionmark"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="\?"
                android:gravity="center"
                android:textSize="22sp"
                android:textColor="#B3C9C6C5"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"/>

            <ImageView
                android:id="@+id/img_large_news_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="fitXY"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:background="@drawable/large_news_card_fade_widget_large"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="12dp"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/img_sentiment"
                    android:layout_width="10dp"
                    android:layout_height="6dp"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/trend_still"
                    app:tint="#C9C6C5"
                    android:background="@drawable/widget_number_background_dark"/>

                <TextView
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:id="@+id/txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:text="Crypto News"/>

                <TextView
                    android:id="@+id/txt_published"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CoinCurrently"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_light"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"/>

            </LinearLayout>

            <RelativeLayout
                android:id="@+id/btn_open"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            </RelativeLayout>

        </RelativeLayout>

        <include
            layout="@layout/widget_separator_dark"
            android:layout_height="1dp"
            android:layout_width="match_parent"/>

        <LinearLayout
            android:id="@+id/cell_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                layout="@layout/medium_news_widget_card"
                android:layout_height="match_parent"
                android:layout_width="match_parent"/>

        </LinearLayout>

        <include
            layout="@layout/widget_separator_dark"
            android:layout_height="1dp"
            android:layout_width="match_parent"/>


        <LinearLayout
            android:id="@+id/cell_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include
                layout="@layout/medium_news_widget_card"
                android:layout_height="match_parent"
                android:layout_width="match_parent"/>

        </LinearLayout>

    </LinearLayout>

    <include
        android:id="@+id/buy_pro"
        layout="@layout/buy_pro_overlay"
        android:layout_height="330dp"
        android:layout_width="330dp"
        android:visibility="gone"
        tools:visibility="visible"/>

    <include
        android:id="@+id/buy_pro_light"
        layout="@layout/buy_pro_overlay_light"
        android:layout_height="330dp"
        android:layout_width="330dp"
        android:visibility="gone"
        tools:visibility="visible"/>

</RelativeLayout>