<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_portfolio_empty"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/btn_add_transaction_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_portfolio_empty_button_background_dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/txt_add_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:fontFamily="@font/satoshi_bold"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="Add Transaction"
            android:textAlignment="center"
            android:textColor="#1B0E00"
            android:textFontWeight="700"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
